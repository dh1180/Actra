<Window x:Class="Actra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actra"
        Width="760"
        Height="430"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated"
        SourceInitialized="Window_SourceInitialized">

    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="18"
            BorderBrush="#34363F"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="12"
                    BorderBrush="#353740"
                    BorderThickness="1"
                    Padding="16,12">
                <DockPanel>
                    <TextBlock Text="✦"
                               FontSize="20"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="QueryBox"
                             FontSize="21"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             VerticalContentAlignment="Center"
                             KeyDown="QueryBox_KeyDown"
                             TextChanged="QueryBox_TextChanged"
                             ToolTip="파일 찾기, 앱 실행, 시스템 명령을 자연어로 입력하세요"/>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="HintText"
                           Text="예: “계산기 열어줘”, “다운로드에서 pdf 찾아줘”, “메모장 실행”"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="14"
                           Margin="8,4,8,14"/>

                <Border x:Name="ResultPanel"
                        Background="#1C1D22"
                        CornerRadius="12"
                        BorderBrush="#2F3138"
                        BorderThickness="1"
                        Padding="16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResultDetail"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <DockPanel Grid.Row="3" Margin="4,14,4,0">
                <TextBlock Text="Actra · Local-first Windows command center"
                           Foreground="#6F727B"
                           FontSize="11"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Ctrl + Space"
                           Foreground="#8B8E97"
                           FontSize="11"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
